# Dodo Payments Configuration
# Dodo uses the SAME API key for test and live — only the base URL changes.
# Get your key from: https://app.dodopayments.com/developer/api-keys

# Single API key (works for BOTH test and live environments)
DODO_API_KEY=your_api_key_here

# Fallback environment — used only when Supabase is unavailable.
# Normal env switching is done via Supabase `dodo_config` table (instant, no redeploy).
DODO_ENV=test

# Product IDs — these ARE environment-specific (test vs live are different products)
DODO_PRODUCT_ID_TEST=pdt_0NgJpLrjYb5WyvHwo2Z5X
DODO_PRODUCT_ID_LIVE=pdt_0Ngn5Lx3viEHrW1dSSp0i

# Supabase (for instant env switching — reads from `dodo_config` table)
SUPABASE_URL=https://wwsjfjrbqlarzyjwpyys.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Webhook secret (get from Dodo dashboard → Developer → Webhooks)
DODO_WEBHOOK_SECRET=
